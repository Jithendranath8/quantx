# ======================================================================
# QuantX — AI Trading Research Platform
# Environment Configuration
# ======================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ======================================================================

# ----------------- Application -----------------
APP_NAME=QuantX
APP_ENV=development
# Must be false in production; the app refuses to start otherwise.
DEBUG=false
LOG_LEVEL=INFO
# REQUIRED. Also used as the /metrics basic-auth password.
SECRET_KEY=

# ----------------- Backend Server -----------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OAuth 2.0 sign-in (optional). A provider appears on the login page only when
# both its id and secret are set. Register this callback with each provider:
#   <PUBLIC_API_URL>/api/v1/auth/oauth/<google|github>/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Public URL of this API, and of the SPA the browser returns to after sign-in.
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ----------------- PostgreSQL -----------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=quantx
# REQUIRED. Compose refuses to start without it.
POSTGRES_PASSWORD=
POSTGRES_DB=quantx

# Pool sizing is PER PROCESS. Total connections are
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) x (API workers + Celery workers).
# Keep the total below the server's max_connections (compose sets 200).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_COMMAND_TIMEOUT_SECONDS=30

# ----------------- Redis -----------------
REDIS_HOST=redis
REDIS_PORT=6379
# REQUIRED. An unauthenticated Redis is a remote code execution risk.
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ----------------- JWT Authentication -----------------
# REQUIRED, and must differ from SECRET_KEY.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------- Binance -----------------
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true

# Host for reading public mainnet market data (klines, depth, tickers). Defaults
# to Binance's public data mirror, which is NOT geo-blocked from most datacenter
# regions — api.binance.com returns HTTP 451 from restricted locations (e.g. many
# US/cloud IPs). Only change this if you deploy where api.binance.com is allowed.
BINANCE_MARKET_DATA_URL=https://data-api.binance.vision

# SAFETY INTERLOCK. Placing real orders requires BOTH
# BINANCE_TESTNET=false AND ALLOW_MAINNET_TRADING=true.
# Leave this false unless you intend to trade real funds.
ALLOW_MAINNET_TRADING=false

# ----------------- AI Provider (OpenAI-compatible) -----------------
# The agent speaks the OpenAI chat-completions API, so ANY compatible endpoint
# works and OpenAI billing is not required. Leave OPENAI_BASE_URL unset to use
# OpenAI itself.
#
#   Local (free, no key, no account) -- install ollama, then `ollama pull qwen2.5:3b`
#     OPENAI_BASE_URL=http://host.docker.internal:11434/v1   # from Docker
#     OPENAI_BASE_URL=http://localhost:11434/v1              # running on the host
#     OPENAI_MODEL=qwen2.5:3b   # smallest verified to pass validation
#     OPENAI_API_KEY=                                        # not needed
#
#   Google Gemini (free tier, key from aistudio.google.com)
#     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     OPENAI_MODEL=gemini-2.0-flash
#
#   Groq (free tier, key from console.groq.com)
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_MODEL=openai/gpt-oss-120b
#
#   OpenAI
#     OPENAI_BASE_URL=            # unset
#     OPENAI_MODEL=gpt-4o
#
# Small local models are weak at arithmetic. The deterministic validator
# recomputes every risk:reward from the model's own prices and downgrades a
# mismatched decision to WAIT, so a weak model degrades safely rather than
# producing a confidently wrong trade.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# ----------------- Agentic LLM runtime -----------------
# The multi-agent runtime (tool-calling loop + LangGraph orchestration) is
# provider-agnostic. LLM_PROVIDER=auto prefers Anthropic when ANTHROPIC_API_KEY
# is set, otherwise the OpenAI-compatible endpoint above (incl. local Ollama).
LLM_PROVIDER=auto                 # auto | anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Hard ceiling on tool-calling iterations per agent run (guarantees termination).
AGENT_MAX_TOOL_ITERATIONS=8

# ----------------- Machine learning / MLOps -----------------
# Requires the optional extra: pip install -e '.[ml]'  (use the CPU torch wheel:
# pip install torch --index-url https://download.pytorch.org/whl/cpu)
ML_MODEL_DIR=./ml_artifacts        # where trained artifacts + metadata are written
MLFLOW_TRACKING_URI=               # unset → local ./mlruns file store
ML_SEQUENCE_LENGTH=16
ML_DEFAULT_SYMBOL=BTCUSDT
ML_DEFAULT_TIMEFRAME=1h

# ----------------- MCP server (optional) -----------------
# For `python -m app.mcp.server` (pip install -e '.[mcp]'). Identity/permissions
# are bound here, never by the MCP client.
QUANTX_MCP_USER_ID=                # bind calls to this user UUID (user-scoped tools)
QUANTX_MCP_ALLOW_MUTATIONS=false   # true permits paper-order / kill-switch tools
QUANTX_MCP_ACCOUNT_BALANCE=100000

# ----------------- Celery -----------------
# Points at the dedicated broker instance (noeviction), never the cache.
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis-broker:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis-broker:6379/2
CELERY_CONCURRENCY=4

# ----------------- Rate Limiting -----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=10

# ----------------- Workload Guardrails -----------------
MAX_TIMEFRAMES_PER_REQUEST=8
BACKTEST_MAX_CANDLES=20000
EXPORT_MAX_ROWS=100000

# ----------------- Data Retention (days; 0 disables pruning) -----------------
RETENTION_CANDLES_DAYS=400
RETENTION_EVENT_LEDGER_DAYS=365
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_AI_DECISION_LOG_DAYS=365

# ----------------- Market Coverage -----------------
# Single source of truth for which markets the platform covers. Drives the
# API's symbol list, the WebSocket stream, and the scheduled backfill, so the
# UI cannot offer a pair that nothing ingests.
#
# Public market data (klines, ticker, order book) always reads Binance MAINNET
# regardless of BINANCE_TESTNET: testnet keeps only ~28 days of history against
# mainnet's 400+, which would cap every backtest to under a month. Order flow
# still uses the venue BINANCE_TESTNET selects.
MARKET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,AVAXUSDT,DOGEUSDT
MARKET_TIMEFRAMES=1m,5m,15m,1h,4h,1d

# ----------------- Market Data Ingestion -----------------
# Off by default; enable to start the Binance WebSocket stream on boot and
# push live prices to the UI over the WebSocket gateway instead of polling.
MARKET_STREAM_ENABLED= true
MARKET_STREAM_SYMBOLS=BTCUSDT,ETHUSDT
MARKET_STREAM_INTERVALS=1m

# ----------------- Derivatives Ingestion -----------------
# Perpetual symbols whose funding rate and open interest are ingested for the
# AI agent's market context. These are public mainnet reads and are unaffected
# by BINANCE_TESTNET; Binance retains only ~30 days of open-interest history.
DERIVATIVES_SYMBOLS=BTCUSDT,ETHUSDT
DERIVATIVES_BACKFILL_DAYS=30

# ----------------- Monitoring -----------------
PROMETHEUS_ENABLED=true
# /metrics requires HTTP basic auth using SECRET_KEY as the password.
METRICS_REQUIRE_AUTH=true
GRAFANA_ADMIN_USER=admin
# REQUIRED.
GRAFANA_ADMIN_PASSWORD=

# ----------------- Notifications -----------------
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
