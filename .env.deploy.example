# =====================================================================
# QuantX — environment for a FREE hosted deployment
# =====================================================================
# Copy the values you need into your host's dashboard (Render/Fly/Cloud Run)
# as environment variables. Do NOT commit real secrets.
#
# Generate the secrets:
#   python3 -c "import secrets; [print(f'{k}={secrets.token_urlsafe(48)}') for k in ('SECRET_KEY','JWT_SECRET_KEY','CRON_SECRET')]"

# ---- Core ----
APP_ENV=production
DEBUG=false
SECRET_KEY=            # required, 48+ random chars
JWT_SECRET_KEY=        # required, 48+ random chars
# Your deployed frontend origin(s), comma-separated. NOT localhost in prod.
ALLOWED_ORIGINS=https://your-frontend.pages.dev
# Free tiers are small; one worker keeps the DB connection count low.
BACKEND_WORKERS=1

# ---- Database (Neon / Supabase / Render Postgres) ----
# Paste the provider's connection string verbatim. The app rewrites the scheme
# for asyncpg and strips libpq-only query params automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Redis (Upstash / Redis Cloud) ----
# Use the rediss:// (TLS) URL managed Redis gives you.
REDIS_URL=rediss://default:token@host:6379

# ---- Scheduled jobs (replaces an always-on Celery worker) ----
# Set this AND the same value as a GitHub Actions repo secret (CRON_SECRET) so
# the scheduled-jobs workflow can trigger maintenance. Unset = endpoint disabled.
CRON_SECRET=           # required to enable cron; 48+ random chars

# ---- Trading safety (keep OFF unless you really mean it) ----
BINANCE_TESTNET=true
ALLOW_MAINNET_TRADING=false
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# ---- AI provider (free options) ----
# Point at a free/local OpenAI-compatible endpoint, or set ANTHROPIC_API_KEY.
# Groq (free tier):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
#   OPENAI_API_KEY=<groq key>
# Gemini (free tier):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-2.0-flash
#   OPENAI_API_KEY=<gemini key>
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---- Disable the live market WebSocket on free tiers ----
MARKET_STREAM_ENABLED=false
# Metrics auth is on by default; leave as-is.
